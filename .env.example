# =============================================================================
# Choose ONE provider section and uncomment it. Leave the rest commented.
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION 1 — Local Ollama (default)
# -----------------------------------------------------------------------------
AI_AGENT_PROVIDER=ollama
AI_AGENT_OLLAMA_BASE_URL=http://localhost:11434
AI_AGENT_OLLAMA_MODEL=qwen2.5:7b-instruct

# -----------------------------------------------------------------------------
# OPTION 2 — OpenRouter (Claude, GPT, DeepSeek, etc. via one API)
# Get a free key at https://openrouter.ai/keys (free tier + free models available)
# Recommended models for agents:
#   deepseek/deepseek-chat            -- excellent + cheap (~$0.30/1M tokens)
#   anthropic/claude-haiku-4.5        -- fast, reliable tool calling
#   openai/gpt-4o-mini                -- cheap, very strong agent
#   meta-llama/llama-3.3-70b-instruct -- free tier available
# -----------------------------------------------------------------------------
# AI_AGENT_PROVIDER=openai_compat
# AI_AGENT_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_AGENT_OPENAI_API_KEY=sk-or-v1-...
# AI_AGENT_OPENAI_MODEL=deepseek/deepseek-chat

# -----------------------------------------------------------------------------
# OPTION 3 — OpenAI directly
# -----------------------------------------------------------------------------
# AI_AGENT_PROVIDER=openai_compat
# AI_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_AGENT_OPENAI_API_KEY=sk-...
# AI_AGENT_OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# OPTION 4 — Local OpenAI-compatible (vLLM, LM Studio, llama.cpp server)
# -----------------------------------------------------------------------------
# AI_AGENT_PROVIDER=openai_compat
# AI_AGENT_OPENAI_BASE_URL=http://localhost:1234/v1
# AI_AGENT_OPENAI_API_KEY=not-needed
# AI_AGENT_OPENAI_MODEL=qwen2.5-coder-7b-instruct

# =============================================================================
# Agent behavior
# =============================================================================
AI_AGENT_MAX_STEPS=25
AI_AGENT_TEMPERATURE=0.2
AI_AGENT_WORKSPACE=.

# Safety
AI_AGENT_REQUIRE_CONFIRMATION=true
AI_AGENT_PERMISSION_LEVEL=normal   # safe | normal | full

# Storage
AI_AGENT_DB_PATH=./data/agent.db
AI_AGENT_LOG_DIR=./logs

# =============================================================================
# Hybrid multimodal (optional) — route vision/audio to a DIFFERENT provider
# than the agent's main one. Common setup: agent on OpenRouter (smart but
# pay-per-token text), vision on local Ollama (free, no API cost per image).
# =============================================================================
# AI_AGENT_VISION_PROVIDER=ollama
# AI_AGENT_VISION_BASE_URL=http://localhost:11434
# AI_AGENT_VISION_MODEL=gemma4

# AI_AGENT_AUDIO_PROVIDER=ollama
# AI_AGENT_AUDIO_BASE_URL=http://localhost:11434
# AI_AGENT_AUDIO_MODEL=gemma4
